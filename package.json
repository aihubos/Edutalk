    "react-dom": "^19.2.0",
    "server-only": "0.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.0",
    "tsx": "4.20.6",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.30.1"
